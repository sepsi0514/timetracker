<Window x:Class="TimeTracker.DeleteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete work item"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="White" CornerRadius="14" BorderBrush="#DDE4E5" BorderThickness="1" Padding="26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.18" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="#FCE9E7" CornerRadius="19" Margin="0,0,12,0">
                        <TextBlock Text="!" FontSize="22" FontWeight="SemiBold" Foreground="#A33A32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Delete work item?" FontSize="20" FontWeight="SemiBold" Foreground="#1B2A2F" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="×" Width="30" Height="30" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="#68777C" FontSize="20" Click="Cancel_Click" />
            </Grid>

            <TextBlock Grid.Row="1" Text="You're about to delete this item:" FontSize="14" Foreground="#68777C" Margin="0,0,0,10" />
            <Border Grid.Row="2" Background="#F6F8F8" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <TextBlock x:Name="ItemNameText" FontSize="15" FontWeight="SemiBold" Foreground="#263238" TextWrapping="Wrap" />
            </Border>
            <TextBlock Grid.Row="3" Text="All recorded time for this item will also be deleted. This can't be undone." FontSize="13" Foreground="#68777C" TextWrapping="Wrap" Margin="0,0,0,22" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="88" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Delete item" MinWidth="104" Background="#A33A32" Foreground="White" FontWeight="SemiBold" Click="Delete_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>